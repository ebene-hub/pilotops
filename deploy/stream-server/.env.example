# Stream server config — copy to .env and fill in. Do NOT commit .env.

# Public hostname that points (DNS A record) at this server's IP. Caddy gets a
# TLS cert for it. e.g. stream.yourdomain.com  or  pilotops-stream.duckdns.org
STREAM_DOMAIN=stream.example.com

# Your Supabase Cloud project (the gateway validates tokens + uploads recordings).
SUPABASE_URL=https://zfpuulhgcubndcywfjxy.supabase.co
# Settings → API → service_role key. SERVER-SIDE ONLY — never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
