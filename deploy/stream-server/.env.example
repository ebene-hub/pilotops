# Stream server config — copy to .env and fill in. Do NOT commit .env.

# Public hostname that points (DNS A record) at this server's IP. Caddy gets a
# TLS cert for it. e.g. stream.yourdomain.com  or  pilotops-stream.duckdns.org
STREAM_DOMAIN=stream.example.com

# Your Supabase Cloud project (the gateway validates tokens + uploads recordings).
SUPABASE_URL=https://zfpuulhgcubndcywfjxy.supabase.co
# Settings → API → service_role key. SERVER-SIDE ONLY — never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Email delivery — SERVER-WIDE FALLBACK. Each organization can override this in
# Admin → System → Email delivery (its own SMTP server or Resend key). If an org
# has no active config, the gateway uses whichever of these is set below.
#
# MAIL_FROM is the default sender for the fallback transport.
MAIL_FROM=Pilot Ops <onboarding@resend.dev>
#
# Option A — a global SMTP server (works with any provider incl. Gmail, your host):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_USER=
SMTP_PASS=
#
# Option B — a global Resend key (used only if SMTP_HOST is blank):
RESEND_API_KEY=
