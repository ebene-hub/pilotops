# Single HTTPS origin for the whole app.
# - Supabase API paths are proxied to the kong gateway (port 8000).
# - Everything else is served by the web (nginx) container.
#
# {$DOMAIN} comes from the compose `DOMAIN` env. For a public host, Caddy gets a
# real certificate automatically. For local testing use DOMAIN=localhost (Caddy
# serves an internal cert) or set DOMAIN to your machine's hostname.

{$DOMAIN} {
	@supabase path /auth/v1/* /rest/v1/* /realtime/v1/* /storage/v1/* /functions/v1/*
	handle @supabase {
		reverse_proxy kong:8000
	}

	# Live video — WebRTC (WHEP) signalling, and HLS fallback. The prefix is
	# stripped so MediaMTX sees /<flightId>/whep and /<flightId>/index.m3u8.
	# (WebRTC media itself flows over UDP 8189 direct to the mediamtx container.)
	handle_path /stream/* {
		reverse_proxy mediamtx:8889
	}
	handle_path /hls/* {
		reverse_proxy mediamtx:8888
	}
	handle /grant {
		reverse_proxy stream-gateway:9000
	}
	handle /record {
		reverse_proxy stream-gateway:9000
	}
	handle /notify-flight {
		reverse_proxy stream-gateway:9000
	}
	handle /send-summary {
		reverse_proxy stream-gateway:9000
	}
	handle /email-status {
		reverse_proxy stream-gateway:9000
	}

	handle {
		reverse_proxy web:80
	}

	encode gzip
}
