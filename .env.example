# Frontend (Vite) — exposed to the browser. Safe to ship; the anon key is public.
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=replace-with-your-anon-key

# Live video (GGIS UAV Companion). Same-origin defaults work behind Caddy
# (/stream → MediaMTX WebRTC/WHEP, /hls → MediaMTX HLS). Override for local dev
# pointing straight at MediaMTX, e.g. http://localhost:8889 and http://localhost:8888.
VITE_STREAM_URL=/stream
VITE_STREAM_HLS_URL=/hls

# ---------------------------------------------------------------------------
# Backend / Docker only — NEVER expose these to the browser.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-32+-char-random-secret
ANON_KEY=replace-with-your-anon-key
SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Live-video stream-gateway: it reaches Supabase over the internal API gateway by
# default (http://kong:8000); override only if your network differs.
STREAM_SUPABASE_URL=http://kong:8000

# Public URL the app is served from (used by GoTrue for redirects/links)
SITE_URL=http://localhost:5173

# One-time bootstrap admin (scripts/bootstrap-admin.mjs)
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
BOOTSTRAP_ADMIN_EMAIL=director@yourorg.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=Operations Director
BOOTSTRAP_ORG_NAME=My Organization
