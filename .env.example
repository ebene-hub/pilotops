# =============================================================================
# Pilot Ops — environment template.  Copy to .env and fill in.  .env is gitignored.
#
# There are two ways Pilot Ops runs; you only need ONE set of values:
#   A) Managed (what we run): frontend on Vercel, DB/Auth/Storage on Supabase
#      Cloud, live-video on a separate EC2 stream server. → fill the FRONTEND
#      section only; the backend section is not used.
#   B) All-in-one Docker (self-hosted single box). → fill BOTH sections.
# =============================================================================

# -----------------------------------------------------------------------------
# FRONTEND (Vite)  —  values with a VITE_ prefix are BAKED INTO THE BROWSER
# BUNDLE at build time and are visible to anyone. Only ever put PUBLIC values
# here. These are also what you set in Vercel → Settings → Environment Variables.
# -----------------------------------------------------------------------------

# Your Supabase project URL.
#   Managed:  https://<project-ref>.supabase.co
#   Docker:   http://localhost:8000
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase PUBLISHABLE key (new: sb_publishable_… ; or the legacy anon JWT eyJ…).
# 🚫 NEVER put a SECRET key here (sb_secret_… or a service_role JWT). Secret keys
#    bypass Row-Level Security and would be exposed to every visitor — a full
#    database breach. Secret keys belong ONLY on the server (see below).
VITE_SUPABASE_ANON_KEY=sb_publishable_replace-with-your-publishable-key

# Live video — where the browser reaches the stream server (MediaMTX via Caddy).
#   Managed:  point at the EC2 stream host, e.g.
#             VITE_STREAM_URL=https://pilotops-stream.duckdns.org/stream
#             VITE_STREAM_HLS_URL=https://pilotops-stream.duckdns.org/hls
#   Docker (same origin behind Caddy):  /stream  and  /hls
VITE_STREAM_URL=https://<stream-host>/stream
VITE_STREAM_HLS_URL=https://<stream-host>/hls

# Optional frontend tuning (safe defaults if omitted):
#   Media-gallery capacity bar — your Supabase plan's storage limit in GB
#   (Free = 1, Pro = 100).
VITE_STORAGE_QUOTA_GB=1
#   Receiver jitter buffer in ms (lower = less latency, higher = smoother on poor
#   connections). Default 500.
# VITE_STREAM_JITTER_MS=500

# =============================================================================
# BACKEND / DOCKER ONLY  —  used for the all-in-one self-hosted stack (option B).
# NOT used by the managed Vercel + Supabase Cloud + EC2 setup. NEVER expose to
# the browser (no VITE_ prefix).
# =============================================================================
POSTGRES_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-32+-char-random-secret
ANON_KEY=replace-with-your-anon-key
SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Live-video stream-gateway reaches Supabase over the internal API gateway by
# default (http://kong:8000); override only if your network differs.
STREAM_SUPABASE_URL=http://kong:8000

# Public URL the app is served from (used by GoTrue for redirects/links).
SITE_URL=http://localhost:5173

# One-time bootstrap admin (scripts/bootstrap-admin.mjs).
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
BOOTSTRAP_ADMIN_EMAIL=director@yourorg.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=Operations Director
BOOTSTRAP_ORG_NAME=My Organization
